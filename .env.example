# ==============================================
# Binance Agentic 环境变量配置模板 (.env)
# 使用方式：复制本文件为 .env 并填入真实凭证
# ==============================================

# 1. 币安 CEX API 密钥对（用于现货、合约、量化与账户查询）
BINANCE_API_KEY=YOUR_BINANCE_API_KEY
BINANCE_SECRET_KEY=YOUR_BINANCE_SECRET_KEY
BINANCE_API_ENV=prod

# 2. 网络代理配置（若开启 TUN 透明代理模式则无需修改）
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890

# 3. Web3 链配置（如 56 代表 BSC，CT_501 代表 Solana）
BINANCE_CHAIN_ID=56

# 4. 币安广场内容挖矿 Open API Key（用于自动化发帖）
BINANCE_SQUARE_OPENAPI_KEY=YOUR_SQUARE_OPENAPI_KEY

# 5. TypeSafe AI（System One / Jev 结构化语义判定）
TYPESAFE_API_KEY=YOUR_TYPESAFE_API_KEY
# 自定义端点（使用第三方中转/代理服务商时填入完整端点，如未设置则默认走官方 https://api.typesafe.ai/v1/systemone）
# TYPESAFE_ENDPOINT=https://your-custom-proxy.com/v1/systemone
# 或者提供 BASE_URL（会自动补充 /systemone）：
# TYPESAFE_BASE_URL=https://your-custom-proxy.com/v1
# 自定义模型名称（默认 jev-latest，第三方有自定义别名时可修改）：
# TYPESAFE_MODEL=jev-latest


